# Neon Postgres — pooled URL for the app, direct (non "-pooler") URL for drizzle-kit migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Better Auth). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cache (sessions, goals, settings): Upstash works everywhere incl. Cloudflare Workers;
# REDIS_URL is a plain Redis for local / VPS (used only when Upstash is not set).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
