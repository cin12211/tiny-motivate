{
  "name": "motivation-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @motivation/web dev",
    "build": "pnpm --filter @motivation/web build",
    "preview": "pnpm --filter @motivation/web preview",
    "db:make-admin": "pnpm --filter @motivation/web db:make-admin",
    "mobile:build": "pnpm --filter @motivation/web generate:mobile && pnpm --filter @motivation/mobile sync",
    "mobile:ios": "pnpm --filter @motivation/mobile open:ios",
    "mobile:android": "pnpm --filter @motivation/mobile open:android"
  }
}
